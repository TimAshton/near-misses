# Backend (see backend/src/near_misses/config.py)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/near_misses
S3_BUCKET=near-misses-raw-archive
S3_ENDPOINT_URL=http://localhost:4566   # localstack; unset/remove for real AWS
AWS_REGION=us-west-2
NTSB_API_BASE=https://data.ntsb.gov/carol-main-public/api/Query/Main
AVIATIONWEATHER_API_BASE=https://aviationweather.gov/api/data
USGS_API_BASE=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
NWS_API_BASE=https://api.weather.gov
NWS_USER_AGENT=near-misses-incident-map (https://incidents.tashton.com)
FRA_API_BASE=https://data.transportation.gov/resource/85tf-25kj.json
POLL_INTERVAL_MINUTES=5
SCHEDULER_ENABLED=true

# Frontend
VITE_API_URL=http://localhost:8000
